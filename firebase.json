{
  "hosting": {
    "site": "praan-health-site",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "trailingSlash": true,
    "redirects": [
      { "source": "/clinics-old", "destination": "/clinics/", "type": 301 },
      { "source": "/condition", "destination": "/clinics/", "type": 301 },
      { "source": "/conditions/**", "destination": "/clinics/", "type": 301 },
      { "source": "/patient-stories/**", "destination": "/", "type": 301 },
      { "source": "/for-families", "destination": "/protocols/", "type": 301 },
      { "source": "/health-pass", "destination": "/", "type": 301 },
      { "source": "/thankyou", "destination": "/", "type": 301 },
      { "source": "/search", "destination": "/", "type": 301 }
    ],
    "rewrites": [{ "source": "/api/forms", "run": { "serviceId": "ph-website-forms", "region": "asia-south1" } }],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
        ]
      },
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/assets/**/*.@(js|css)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "**/*.@(webp|png|jpg|jpeg|svg|mp4|woff2|woff|ttf|ico)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
    ]
  }
}
